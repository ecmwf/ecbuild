set -e

HERE="$( cd $( dirname "${BASH_SOURCE[0]}" ) && pwd -P )"

# --------------------- cleanup ------------------------
rm -rf $HERE/build

# ---------------- build the bundle --------------------
cd $HERE

mkdir build
cd build
cmake @mybundle_SOURCE_DIR@

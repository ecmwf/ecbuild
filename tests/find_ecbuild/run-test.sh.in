set -e

HERE="$( cd $( dirname "${BASH_SOURCE[0]}" ) && pwd -P )"

cd $HERE

rm -rf build # cleanup
mkdir build
cd build

@_EXPORTS@
cmake @_CMDLINE_OPTS@ ..